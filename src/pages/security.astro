---
import { getEntry } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";

const entry = await getEntry("home", "page");
if (!entry) {
  throw new Error("Missing home page content");
}

const email = entry.data.footer.email;
const meta = {
  title: "Security at Marres | Marres",
  description:
    "Read about the high-level controls that protect Marres accounts and customer data.",
  canonicalUrl: "https://marres.io/security",
};
---

<SiteLayout {...meta}>
  <article class="legal-page">
    <div class="legal-content">
      <span class="tag">Trust</span>
      <h1>Security</h1>
      <p class="legal-date">Updated 3 September 2026</p>
      <p class="legal-intro">
        This page describes the high-level controls used to protect Marres
        accounts and customer data. Marres does not claim a certification,
        independent audit, or security guarantee.
      </p>

      <section>
        <h2>Accounts and access</h2>
        <p>
          Marres securely hashes passwords and does not store them in plain
          text. Access checks restrict each user to authorised organisations and
          actions.
        </p>
      </section>

      <section>
        <h2>Sessions and requests</h2>
        <p>
          Marres protects browser sessions and sensitive requests against
          unauthorised use. Production access requires encrypted network
          connections.
        </p>
      </section>

      <section>
        <h2>Service operations</h2>
        <p>
          We limit and monitor automated processing and access to external
          services. We restrict service credentials and do not store them in
          public source code.
        </p>
      </section>

      <section>
        <h2>Report a concern</h2>
        <p>
          Email <a href={`mailto:${email}`}>{email}</a> with a security concern. Include
          the affected page, what you observed, and how we can contact you. Do not
          send passwords, payment details, private keys, or other secrets by email.
        </p>
      </section>
    </div>
  </article>
</SiteLayout>
