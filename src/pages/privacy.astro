---
import { getEntry } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";

const entry = await getEntry("home", "page");
if (!entry) {
  throw new Error("Missing home page content");
}

const email = entry.data.footer.email;
const meta = {
  title: "Privacy Policy | Marres",
  description:
    "Read how Marres handles account, billing, business, public-source, and analysis data for its launch service.",
  canonicalUrl: "https://marres.io/privacy",
};
---

<SiteLayout {...meta}>
  <article class="legal-page">
    <div class="legal-content">
      <span class="tag">Legal</span>
      <h1>Privacy policy</h1>
      <p class="legal-date">Effective 3 September 2026</p>
      <p class="legal-intro">
        This policy explains how Marres Insights Pte Ltd handles data for the
        Marres launch service and this website.
      </p>

      <section>
        <h2>Data we handle</h2>
        <h3>Accounts and access</h3>
        <p>
          We store contact, account, authentication, and access data. We do not
          store your password in plain text.
        </p>
        <h3>Billing</h3>
        <p>
          When billing is enabled, we store billing and subscription records.
          Our payment provider hosts the payment and billing pages. Marres does
          not store payment-card details.
        </p>
        <h3>Business information and analysis</h3>
        <p>
          We store business information that you submit, requested public-source
          content, and the analysis and results produced for you. Public content
          can include personal information that a person chose to publish.
        </p>
      </section>

      <section>
        <h2>Why we use it</h2>
        <p>We use this data to:</p>
        <ul>
          <li>provide account access and billing;</li>
          <li>collect and process the requested public-source content;</li>
          <li>produce and display analysis;</li>
          <li>maintain the accuracy and traceability of results; and</li>
          <li>secure, operate, support, and diagnose the service.</li>
        </ul>
      </section>

      <section>
        <h2>Who receives data</h2>
        <p>
          Service providers that support payment, hosting, public-source
          collection, analysis, and service operations receive only the data
          needed for their work. We can also disclose data when required by law.
        </p>
        <p>
          When you use this website, hosting and content providers can receive
          technical data such as your IP address and browser details.
        </p>
      </section>

      <section>
        <h2>Processing location</h2>
        <p>
          Our service providers can process data outside Singapore. We do not
          make a data-residency promise. We will update this policy if the
          production data boundary changes.
        </p>
      </section>

      <section>
        <h2>Access, correction, and deletion</h2>
        <p>
          Email <a href={`mailto:${email}`}>{email}</a> to ask for access, correction,
          export, or deletion. We may need to verify that you control the account
          before responding.
        </p>
      </section>

      <section>
        <h2>Retention</h2>
        <p>
          We keep account, service, analysis, billing, and security data while
          needed to run and protect the service, support billing, resolve
          disputes, or meet legal duties. Some billing, security, backup, or
          legal records can remain when removal is not permitted or practical.
        </p>
      </section>

      <section>
        <h2>Contact and changes</h2>
        <p>
          Contact <a href={`mailto:${email}`}>{email}</a> with a privacy question
          or request. We may update this policy when the service or its data handling
          changes. The effective date above shows the current version.
        </p>
      </section>
    </div>
  </article>
</SiteLayout>
